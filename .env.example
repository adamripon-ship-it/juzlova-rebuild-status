# Optional. Public Turnstile site key — leave empty to skip captcha.
TURNSTILE_SITE_KEY=

# Turnstile secret — Cloud Run / local .env only, never commit
TURNSTILE_SECRET_KEY=

# Optional. Comma list of hostnames Turnstile tokens may come from.
TURNSTILE_HOSTNAMES=juzlova.cz,www.juzlova.cz

# Optional Zapier Catch Hook. JSON post; the Zap should email juzlj@seznam.cz
# Example: https://hooks.zapier.com/hooks/catch/123456/abcdef/
ZAPIER_WEBHOOK_URL=

# Optional SMTP — used when Zapier is not set
# SMTP_HOST=smtp.seznam.cz
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=juzlj@seznam.cz

# Optional existing Formspree form hash only — never invent a fake ID
# FORMSPREE_FORM_ID=
# FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx

# Inbox for form deliveries
CONTACT_TO=juzlj@seznam.cz

# Optional. Cloudflare Web Analytics token — leave empty to skip the visitor counter.
# CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# Optional. Google Analytics 4 Measurement ID (G-XXXXXXXX). Leave empty to skip.
# Google's script loads only after the visitor accepts cookies.
# GOOGLE_ANALYTICS_MEASUREMENT_ID=
# GA_MEASUREMENT_ID=

# GCS bucket for ratings + contact inbox (Cloud Run default)
# DATA_BUCKET=aiapply-ch-juzlova-data
