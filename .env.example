# Native Google Form (Google Forms → Send → Embed).
# Paste the iframe src URL. Must start with https://docs.google.com/forms/
# Example: https://docs.google.com/forms/d/e/1FAIpQL.../viewform?embedded=true
GOOGLE_FORM_EMBED_URL=

# Public Turnstile site key (unused while contact is Google Form)
TURNSTILE_SITE_KEY=

# Turnstile secret — Netlify UI / local .env only, never commit
TURNSTILE_SECRET_KEY=

# Optional. Comma list of hostnames Turnstile tokens may come from.
TURNSTILE_HOSTNAMES=juzlova.cz,www.juzlova.cz

# Zapier Catch Hook. Unused while contact is Google Form. Secret — never commit.
# Example: https://hooks.zapier.com/hooks/catch/123456/abcdef/
ZAPIER_WEBHOOK_URL=

# Optional override; the Zap should still email this address
CONTACT_TO=juzlj@seznam.cz
