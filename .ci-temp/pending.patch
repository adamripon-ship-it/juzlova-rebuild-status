+.prod-links a::before { content: ""; position: absolute; left: 0; right: 0; top: -1px; height: 2px; background: var(--gold); transform: scaleX(0); transform-origin: left; transition: transform .55s var(--ease-expo); }
+.pl-name { font-weight: 500; line-height: 1.3; text-wrap: balance; overflow-wrap: break-word; }
+.pl-prices { margin-top: auto; display: grid; gap: .3rem; font-variant-numeric: tabular-nums; }
+.pl-price { display: flex; justify-content: space-between; gap: .75rem; white-space: nowrap; }
+.pl-pack { color: var(--grey); }
+.pl-price b { font-weight: 600; }
+.pl-arrow { position: absolute; top: .6rem; right: 1.1rem; width: 20px; height: 13px; fill: none; stroke: var(--ink); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; opacity: 0; transform: translateX(-8px); transition: opacity .3s var(--ease), transform .45s var(--ease-expo); }
+.prod-links a:focus-visible::before { transform: scaleX(1); }
+.prod-links a:focus-visible .pl-arrow { opacity: 1; transform: none; }
+@media (hover: hover) {
+  .prod-links a:hover::before { transform: scaleX(1); }
+  .prod-links a:hover .pl-arrow { opacity: 1; transform: none; }
+  .prod-links a:hover .pl-name { color: var(--ink); }
+}
+.js .prod-links.rv { opacity: 1; transform: none; transition: none; }
+.js .prod-links.rv li { opacity: 0; transform: translateY(14px); transition: opacity .6s var(--ease), transform .7s var(--ease-expo); }
+.js .prod-links.rv.is-in li { opacity: 1; transform: none; }
+.js .prod-links.rv.is-in li:nth-child(2) { transition-delay: .06s; }
+.js .prod-links.rv.is-in li:nth-child(3) { transition-delay: .12s; }
+.js .prod-links.rv.is-in li:nth-child(4) { transition-delay: .18s; }
+.js .prod-links.rv.is-in li:nth-child(5) { transition-delay: .24s; }
+@media (max-width: 1100px) {
+  .prod-links { grid-template-columns: repeat(6, minmax(0, 1fr)); }
+  .prod-links li { grid-column: span 2; }
+  .prod-links li:nth-child(n+4) { grid-column: span 3; border-top: 1px solid var(--line); }
+  .prod-links li:nth-child(4) { border-left: 0; }
+}
+@media (max-width: 700px) {
+  .prod-links { grid-template-columns: minmax(0, 1fr); }
+  .prod-links li, .prod-links li:nth-child(n+4) { grid-column: auto; border-left: 0; border-bottom: 1px solid var(--line); border-top: 0; }
+  .prod-links a { flex-direction: row; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 0; min-height: 64px; }
+  .pl-name { flex: 1 1 auto; }
+  .pl-prices { flex: 0 0 auto; margin-top: 0; min-width: 8.2rem; }
+  .pl-arrow { display: none; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .js .prod-links.rv li { opacity: 1; transform: none; transition: none; }
+  .prod-links a::before, .pl-arrow { transition: none; }
+}
 
